<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView style="@style/Title" android:text="@string/detail_title" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:background="@drawable/bg_red_soft" android:gravity="center_vertical">
                <TextView android:id="@+id/tvDetailCode" style="@style/Section" tools:text="#DS001" android:layout_width="0dp" android:layout_weight="1" />
                <TextView android:id="@+id/tvDetailStatus" style="@style/Badge" tools:text="Đã đặt" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <LinearLayout style="@style/Card">
                <TextView style="@style/Section" android:text="@string/booking_info" />
                <Space android:layout_width="1dp" android:layout_height="6dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/customer" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailCustomer" style="@style/TextBase" tools:text="Nguyễn Minh Anh" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/phone" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailPhone" style="@style/TextBase" tools:text="0912 345 678" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/pitch" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailPitch" style="@style/TextBase" tools:text="Sân Mini 01" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/address" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailAddress" style="@style/TextBase" tools:text="12 Nguyễn Trãi, Hà Nội" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/date" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailDate" style="@style/TextBase" tools:text="20/11/2026" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/time_range" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailTime" style="@style/TextBase" tools:text="18:00 – 20:00" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/hours" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailHours" style="@style/TextBase" tools:text="2 giờ" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top">
                    <TextView style="@style/TextBase" android:text="@string/unit_price" android:layout_width="0dp" android:layout_weight="0.42" android:textColor="@color/muted" android:textSize="13sp" />
                    <TextView android:id="@+id/tvDetailPrice" style="@style/TextBase" tools:text="300.000 đ / giờ" android:layout_width="0dp" android:layout_weight="0.58" android:gravity="end" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:background="@drawable/bg_red_soft" android:gravity="center_vertical">
                <TextView style="@style/TextBase" android:text="@string/total" android:layout_width="0dp" android:layout_weight="1" android:textColor="@color/primary" android:textStyle="bold" />
                <TextView android:id="@+id/tvDetailTotal" style="@style/TextBase" tools:text="600.000 đ" android:textColor="@color/primary" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView android:id="@+id/tvCancelNote" style="@style/Subtitle" android:text="@string/cancel_note" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/background">
        <Button android:id="@+id/btnCancelDetail" style="@style/OutlineButton" android:text="@string/cancel_full" />
    </LinearLayout>
</LinearLayout>