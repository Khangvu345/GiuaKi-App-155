<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="16dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="@string/back" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView style="@style/Title" android:text="@string/add_title" />
            <TextView style="@style/Subtitle" android:text="@string/add_subtitle" />
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
            <TextView style="@style/Label" android:text="@string/pitch_code_label" android:labelFor="@id/etCode" />
            <EditText android:id="@+id/etCode" style="@style/Field" android:inputType="textCapCharacters" android:hint="@string/pitch_code_hint" android:maxLength="20" tools:text="SB004" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView style="@style/Label" android:text="@string/pitch_name_label" android:labelFor="@id/etPitchName" />
            <EditText android:id="@+id/etPitchName" style="@style/Field" android:inputType="textCapWords" android:hint="@string/pitch_name_hint" android:maxLength="100" tools:text="Sân Mini 04" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView style="@style/Label" android:text="@string/address_label" android:labelFor="@id/etAddress" />
            <EditText android:id="@+id/etAddress" style="@style/Field" android:inputType="textPostalAddress" android:hint="@string/address_hint" android:maxLength="250" tools:text="46 Nguyễn Trãi, Hà Nội" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <TextView style="@style/Label" android:text="@string/price_label" android:labelFor="@id/etPrice" />
            <EditText android:id="@+id/etPrice" style="@style/Field" android:inputType="number" android:hint="@string/price_hint" android:maxLength="9" tools:text="300000" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_gray">
                <TextView style="@style/TextBase" android:text="@string/auto_status" android:textStyle="bold" />
                <TextView style="@style/Subtitle" android:text="@string/auto_status_note" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/background">
        <Button android:id="@+id/btnSavePitch" style="@style/PrimaryButton" android:text="@string/save_pitch" />
    </LinearLayout>
</LinearLayout>